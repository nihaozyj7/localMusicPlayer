{
  "id": "letterpress",
  "name": "活字",
  "version": "1.0.0",
  "apiVersion": "3.0",
  "author": "第三方样式",
  "description": "整屏只有字：字号/字重/字距/斜切由频谱排成一条排版曲线，换句就是一次活字重排。",
