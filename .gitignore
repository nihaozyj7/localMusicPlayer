# ============================================================================
#  音乐播放器 · Git 忽略规则
#  说明：
#    · build/ 与 frontend/dist 里的「源文件/标记文件」需要入库，其余构建产物忽略
#    · frontend/bindings 是 wails3 generate bindings 的产物，这里选择入库，
#      好处是克隆后直接 `go build` 就能用；如需彻底忽略可去掉对应段落，
#      但那样每次构建前都要先跑 wails3 generate bindings -b -i
# ============================================================================

# ---- 依赖 ----
node_modules/
frontend/node_modules/

# ---- 构建产物 ----
bin/
*.exe
*.exe~
*.syso
*.dll
*.so
*.dylib
*.test
*.out

# wails3 任务缓存与临时目录
.task/
.taskrc

# 前端构建产物：frontend/dist 由 tools/build-frontend.mjs 每次全量重建，
# 体积很小（约 300KB）且 Go 的 go:embed 需要它存在，因此选择入库。
# 想改成不入库的话，取消下面两行注释即可（那样克隆后需先跑一次构建脚本）。
# frontend/dist/*
# !frontend/dist/.gitkeep

# 后端嵌入的内置主题由构建脚本从 frontend/src/styles/themes 同步而来
# （保留入库：go:embed 在干净克隆上也需要这些文件存在）

# ---- 内置 ffmpeg ----
# 静态构建的 ffmpeg.exe 约 155MB，不入库；用 `node tools/fetch-ffmpeg.mjs`
# 或 `wails3 task ffmpeg:fetch` 下载。production 构建会把它编译进 exe。
internal/ffmpeg/bin/*.exe
internal/ffmpeg/bin/_extract/
internal/ffmpeg/bin/*.zip
internal/ffmpeg/bin/VERSION.txt

# ---- 编辑器 ----
.vscode/
.idea/
*.swp

# ---- 系统 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- 本地配置（含个人音乐路径，不入库）----
config.local.json
config.json

# ---- ??????????? ----
.tmp-*/
