# ============================================================================
#  ffmpeg 精简构建的能力清单（唯一事实来源）
# ----------------------------------------------------------------------------
#  build-minimal.sh 读取本文件来生成 configure 参数；
#  tools/build-ffmpeg.mjs --info 读取本文件来核对实际产物是否符合预期。
#  要增删能力，只改这里，不要在脚本里再写一份。
#
#  改动前请先确认代码里确实依赖它：
#    internal/loudness   → loudnorm（EBU R128 测量）
#    internal/ffmpeg     → Probe/SoundDurationMS（volumedetect）、TranscodeToWAV
#    internal/media      → 转码后按 wav 提供播放
# ============================================================================

# 解码器：覆盖 WebView 放不了的格式，以及需要完整解码才能算响度的格式
#   注意 dts 解码器在 ffmpeg 里的名字是 dca（DTS Coherent Acoustics）
DECODERS="aac,alac,ac3,eac3,dca,mp3,flac,vorbis,opus,wmav1,wmav2,wmapro,ape,dsd_lsbf,dsd_msbf,dsd_lsbf_planar,dsd_msbf_planar,wavpack,pcm_s16le,pcm_s24le,pcm_s32le,pcm_u8,pcm_f32le,pcm_f64le,pcm_s16be,pcm_s24be,pcm_s32be"

# 解封装器：mp4/mov 覆盖 m4a/mp4；其余是常见音频容器
DEMUXERS="mov,mp3,flac,ogg,wav,aiff,ape,asf,dsf,iff,wv,matroska,caf,au"

# 编码器：只用 PCM 与 FLAC
ENCODERS="pcm_s16le,flac"

# 封装器：
#   pcm_s16le/pcm_f32le —— 裸 PCM 输出，转码走它（WAV 头由 Go 自己写，
#     这样头长度恒为 44 字节；若让 ffmpeg 直接出 wav，它会插 LIST/INFO 块
#     把 data 挪到偏移 70，媒体服务算 Content-Length / Range 就全错了）。
#     注意 configure 里的名字带 pcm_ 前缀，但命令行 -f 用的是 s16le/f32le。
#   wav/flac/null —— wav 供诊断，flac 备用，null 给 -f null 分析用。
MUXERS="pcm_s16le,pcm_f32le,wav,flac,null"

# 滤镜：loudnorm 做 EBU R128 测量；aresample/aformat 做转码重采样；
#       anull 配合 -f null；volumedetect 用于诊断
FILTERS="loudnorm,aresample,aformat,anull,volumedetect"

# 协议：只读本地文件，不需要网络
PROTOCOLS="file,pipe"

# 解析器与比特流过滤器
#   dca 解析器是 dca(dts) 解码器的依赖，漏了它 configure 会静默丢掉解码器
PARSERS="aac,ac3,dca,flac,mpegaudio,vorbis,opus,dsd"
BSFS="aac_adtstoasc,null"

# 期望的产物体积上限（MB）。超过说明 configure 漏关了东西。
MAX_SIZE_MB=30
